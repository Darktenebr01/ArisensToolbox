  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Arisen's Toolbox panel by Darktenebr01 (tick to show, untick to hide)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript><![CDATA[[ENABLE]
{$lua}
if ATBPanel then ATBPanel.show() end
{$asm}

[DISABLE]
{$lua}
if ATBPanel then ATBPanel.hide() end
{$asm}
]]></AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
  <Comments>Author: Darktenebr01. Official page: https://www.nexusmods.com/dragonsdogma2/mods/1784?tab=description. Arisen's Toolbox CT v1.8: Cheat Engine front-end for ddbridge.lua v1.89.3 (the same REFramework bridge the Arisen's Toolbox app uses). Tick the entry to open the panel. Tabs: Connect, Pawn (rating, favorability, badges, party), Player (level, EXP, vocation, base stats, stat search), Weapon Skills (+ upgraded ExSkills, Add missing entry), Core and Augments, Item Giver, Item Editor, Duplicate, Names, Mods (jump, movement speed, respawn - off until Apply, fast travel). Requires REFramework + ddbridge.lua 1.89.x in reframework\autorun.</Comments>
  <LuaScript><![CDATA[-- Arisen's Toolbox control panel (Cheat Engine side) v1.0 for ddbridge.lua v1.89.3.
-- Talks to the REFramework script through files in <game>\reframework\data\ddbridge\.
-- Protocol v2: ping returns a boot token that every other command must carry,
-- and responses are only complete with the |END sentinel.

if ATBPanel then pcall(function() ATBPanel.destroy() end) end
ATBPanel = {}
local P = ATBPanel
P.VERSION = "1.8"
P.AUTHOR = "Darktenebr01"
P.NEXUS = "https://www.nexusmods.com/dragonsdogma2/mods/1784?tab=description"
P.BRIDGE_MAJOR = "1.89"
P.boot = nil
P.bridgeVersion = nil
P.dataDir = nil
P.q = {}
P.inflight = nil
P.counter = 0
P.connecting = false
P.enums = nil
P.BADGE_NAMES = {
  [20]="Cyclops Clobberer", [21]="Ogre Eliminator", [22]="Grim Ogre Obliterator",
  [23]="Golem Toppler", [24]="Griffin Grounder", [25]="Sphinx Smiter",
  [26]="Chimera Killer", [27]="Gorechimera", [28]="Medusa Maimer",
  [29]="Minotaur Mauler", [30]="Goreminotaur Mangler", [31]="Drake Destroyer",
  [32]="Lesser Dragon Devastator", [33]="Garm Gutter", [34]="Warg Waster",
  [36]="Vernworthian Gallivanter", [37]="Battahli Trailblazer",
  [38]="Norgan Navigator", [40]="Evil Eye Eviscerator",
  [41]="Norgan Giant Annihilator", [42]="Blemmyae Butcherer",
  [43]="Fimbl Flayer", [50]="Death Reaper",
}
P.JOBS = { "Fighter", "Archer", "Mage", "Thief", "Warrior", "Sorcerer",
  "Mystic Spearhand", "Magick Archer", "Trickster", "Warfarer" }
P.LONG = { list_items=60, list_enums=60, get_badges=60, item_rows=60,
  dup_rows=60, stat_search=60, wskill_probe=120, item_special_sweep=60,
  list_pawns=30, item_owners=30, dup_owners=60, get_wstate=30,
  get_nstate=30, get_core=30, stat_set=15 }

---------------------------------------------------------------- helpers
function P.split(s, sep)
  local t = {}
  for part in (s .. sep):gmatch("(.-)" .. sep:gsub("%p", "%%%0")) do t[#t + 1] = part end
  return t
end
function P.trim(s) return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")) end
function P.readfile(path)
  local f = io.open(path, "r")
  if not f then return nil end
  local t = f:read("*a")
  f:close()
  return t
end
function P.writefile(path, text)
  local f = io.open(path, "w")
  if not f then return false end
  f:write(text)
  f:close()
  return true
end
function P.gameDir()
  if getOpenedProcessID() == 0 then return P.gameDirCache end
  local mods = enumModules()
  if mods and mods[1] and mods[1].PathToFile then
    P.gameDirCache = (mods[1].PathToFile:match("^(.*)[\\/][^\\/]+$"))
    return P.gameDirCache
  end
end
function P.resolveDir()
  local gd = P.gameDir()
  if not gd then return false, "Attach Cheat Engine to DD2.exe first (Open Process)." end
  P.dataDir = gd .. "\\reframework\\data\\ddbridge\\"
  if not P.writefile(P.dataDir .. "cmd.txt", "") then
    return false, "Folder not found: " .. P.dataDir ..
      " (install ddbridge.lua in reframework\\autorun and start the game once)"
  end
  return true
end

---------------------------------------------------------------- protocol v2
function P.status(s) if P.statusLbl then P.statusLbl.Caption = s end end

function P.parsePong(payload)
  local v = payload:match("pong ddbridge (%d+%.%d+%.%d+)")
  local b = payload:match("boot=([%w_.:%-]+)")
  if v then P.bridgeVersion = v end
  P.boot = b
  return v, b
end

function P.writeJob(job)
  P.counter = P.counter + 1
  job.id = string.format("%d_%d", os.time() % 1000000, P.counter)
  job.sent = os.clock()
  P.inflight = job
  local line = job.id .. "|" .. job.cmd
  for _, a in ipairs(job.args) do line = line .. "|" .. tostring(a) end
  if P.boot and job.cmd ~= "ping" then line = line .. "|B:" .. P.boot end
  if not P.writefile(P.dataDir .. "cmd.txt", line .. "|END\n") then
    P.inflight = nil
    job.cb(false, "could not write cmd.txt")
    P.pump()
  end
end

function P.doPing(done)
  local job = { cmd = "ping", args = {}, timeout = 8, cb = function(ok, payload)
    if ok then
      local v = P.parsePong(payload)
      P.status("Connected: ddbridge " .. tostring(v) ..
        (P.boot and " (session token ok)" or " (OLD bridge - no session token)"))
    else
      P.log("Ping failed: " .. tostring(payload))
    end
    if done then done(ok) end
  end }
  P.writeJob(job)
end

function P.pump()
  if P.inflight or #P.q == 0 then return end
  if not P.dataDir then
    local ok, err = P.resolveDir()
    if not ok then
      local job = table.remove(P.q, 1)
      job.cb(false, err)
      P.pump()
      return
    end
  end
  local job = P.q[1]
  if job.cmd ~= "ping" and not P.boot then
    if P.connecting then return end
    P.connecting = true
    P.doPing(function(ok)
      P.connecting = false
      if not ok then
        local j = table.remove(P.q, 1)
        if j then j.cb(false, "connect failed - is the game running with ddbridge.lua 1.89.x loaded?") end
      end
      P.pump()
    end)
    return
  end
  table.remove(P.q, 1)
  P.writeJob(job)
end

function P.send(cmd, args, cb, timeout)
  P.q[#P.q + 1] = { cmd = cmd, args = args or {},
    cb = cb or function() end, timeout = timeout or P.LONG[cmd] or 10 }
  P.pump()
end

function P.poll()
  local job = P.inflight
  if not job then P.pump() return end
  local text = P.readfile(P.dataDir .. "resp.txt")
  if text then
    text = text:gsub("[\r\n]+$", "")
    if text:sub(-4) == "|END" then
      local body = text:sub(1, -5)
      local id, st, payload = body:match("^([^|]*)|([^|]*)|(.*)$")
      if id == job.id then
        P.inflight = nil
        if st == "OK" then
          job.cb(true, payload)
        elseif payload == "STALE_SESSION" and not job.retried then
          job.retried = true
          P.boot = nil
          P.connecting = true
          P.doPing(function(ok)
            P.connecting = false
            if ok then
              table.insert(P.q, 1, job)
            else
              job.cb(false, "game session changed and reconnect failed")
            end
            P.pump()
          end)
          return
        else
          job.cb(false, payload or "unknown error")
        end
        P.pump()
        return
      end
    end
  end
  if os.clock() - job.sent > job.timeout then
    P.inflight = nil
    job.cb(false, "timeout - is the game running (not in a loading screen)?")
    P.pump()
  end
end

function P.connect(cb)
  -- Auto-install: if the bundled ddbridge.lua is not what's on disk,
  -- install it first (same as the app's Start), then connect.
  local gd0 = P.gameDir()
  if gd0 and P.BUNDLED_LUA and P.installedBridgeVer(gd0) ~= P.BUNDLED_VER then
    P.installBridge(true)
  end
  local ok, err = P.resolveDir()
  if not ok then P.status(err) P.log("Connect failed: " .. tostring(err)) if cb then cb(false) end return end
  P.log("Connecting (data folder: " .. tostring(P.dataDir) .. ")...")
  P.boot = nil
  P.q[#P.q + 1] = { cmd = "ping", args = {}, timeout = 8, cb = function(ok2, payload)
    if ok2 then
      local v = P.parsePong(payload)
      P.log("Connected: ddbridge " .. tostring(v) .. ".")
      if v and v:sub(1, #P.BRIDGE_MAJOR) ~= P.BRIDGE_MAJOR then
        P.status("WARNING: bridge " .. v .. " found, this panel expects " ..
          P.BRIDGE_MAJOR .. ".x - update ddbridge.lua")
      elseif not P.boot then
        P.status("WARNING: old bridge without session token - update ddbridge.lua to 1.89.x")
      end
      if cb then cb(true) end
    else
      P.status("Connect failed: " .. tostring(payload))
      P.log("Connect failed: " .. tostring(payload))
      if cb then cb(false) end
    end
  end }
  P.pump()
end

function P.loadEnums(cb)
  P.send("list_enums", {}, function(ok, payload)
    if not ok then P.status("Enum load failed: " .. tostring(payload)) return end
    local text = P.readfile(P.dataDir .. "enums.txt") or ""
    local map = {}
    for line in text:gmatch("[^\r\n]+") do
      local kind, val, name = line:match("^([^\t]*)\t([^\t]*)\t(.*)$")
      if kind then
        map[kind] = map[kind] or {}
        map[kind][tonumber(val)] = name
      end
    end
    P.enums = map
    P.status("Enums loaded (" .. tostring(payload) .. " entries).")
    if cb then cb() end
  end)
end
function P.enumName(kind, id)
  if P.enums and P.enums[kind] and P.enums[kind][id] then return P.enums[kind][id] end
  return nil
end

---------------------------------------------------------------- UI scaffolding
local form = createForm(false)
P.form = form
form.Caption = "Arisen's Toolbox CT v" .. P.VERSION .. " by " .. P.AUTHOR .. " (bridge 1.89.3)"
form.Width = 880
form.Height = 800
form.Position = "poScreenCenter"
form.OnClose = function() return caHide end

function P.cbw(f)
  return function(...)
    local ok, e = pcall(f, ...)
    if not ok then P.status("UI error: " .. tostring(e)) end
  end
end
function P.lbl(parent, text, x, y)
  local l = createLabel(form)
  l.Parent = parent
  l.Caption = text
  l.Left, l.Top = x, y
  return l
end
function P.edit(parent, text, x, y, w)
  local e = createEdit(form)
  e.Parent = parent
  e.Text = text
  e.Left, e.Top, e.Width = x, y, w
  return e
end
function P.btn(parent, text, x, y, w, fn)
  local b = createButton(form)
  b.Parent = parent
  b.Caption = text
  b.Left, b.Top, b.Width = x, y, w
  b.OnClick = P.cbw(fn)
  return b
end
function P.combo(parent, x, y, w)
  local c = createComboBox(form)
  c.Parent = parent
  c.Left, c.Top, c.Width = x, y, w
  c.Style = csDropDownList
  return c
end
function P.check(parent, text, x, y, checked)
  local c = createCheckBox(form)
  c.Parent = parent
  c.Caption = text
  c.Left, c.Top = x, y
  c.Checked = checked and true or false
  return c
end
function P.list(parent, x, y, w, h)
  local l = createListBox(form)
  l.Parent = parent
  l.Left, l.Top, l.Width, l.Height = x, y, w, h
  return l
end
function P.memo(parent, x, y, w, h)
  local m = createMemo(form)
  m.Parent = parent
  m.Left, m.Top, m.Width, m.Height = x, y, w, h
  m.ReadOnly = true
  m.ScrollBars = ssVertical
  return m
end
function P.setList(lb, lines)
  lb.Items.clear()
  for _, s in ipairs(lines) do lb.Items.add(s) end
end
function P.setListBulk(lb, lines)
  -- Fast path for thousands of rows: one Items.Text assignment instead
  -- of thousands of Items.add calls (which also silently capped the
  -- Item Giver list in practice). Verified via Items.Count, with the
  -- plain loop as fallback.
  local ok = pcall(function() lb.Items.Text = table.concat(lines, "\r\n") end)
  if ok and lb.Items.Count == #lines then return end
  P.setList(lb, lines)
end
function P.sel(lb)
  local i = lb.ItemIndex
  if i == nil or i < 0 then return nil end
  return i + 1
end
function P.target() return P.targetCombo.ItemIndex == 1 and "pawn" or "player" end
function P.job() return (P.jobCombo.ItemIndex or 0) + 1 end

local topBar = createPanel(form)
topBar.Parent = form
topBar.Align = alTop
topBar.Height = 34
P.lbl(topBar, "Target:", 10, 8)
P.targetCombo = P.combo(topBar, 58, 5, 130)
P.targetCombo.Items.add("Player (Arisen)")
P.targetCombo.Items.add("Main pawn")
P.targetCombo.ItemIndex = 0
P.lbl(topBar, "Vocation:", 205, 8)
P.jobCombo = P.combo(topBar, 268, 5, 170)
for _, j in ipairs(P.JOBS) do P.jobCombo.Items.add(j) end
P.jobCombo.ItemIndex = 0
P.btn(topBar, "Connect", 455, 4, 90, function() P.connect() end)
P.btn(topBar, "Load enums", 552, 4, 100, function() P.loadEnums() end)
P.btn(topBar, "Nexus page", 659, 4, 95, function() shellExecute(P.NEXUS) end)
P.verLbl = P.lbl(topBar, "not connected", 762, 8)

P.statusLbl = createLabel(form)
P.statusLbl.Parent = form
P.statusLbl.Align = alBottom
P.statusLbl.Caption = "Open Process -> DD2.exe, load a save, then press Connect."

local pages = createPageControl(form)
pages.Parent = form
pages.Align = alClient
P.pages = pages
function P.tab(name)
  local t = pages.addTab()
  t.Caption = name
  return t
end

---------------------------------------------------------------- Connect tab
do
  local t = P.tab("Connect")
  P.lbl(t, "Arisen's Toolbox CT v" .. P.VERSION .. "  -  by " .. P.AUTHOR, 10, 10)
  P.lbl(t, "Official page (updates, support, the real download): " .. P.NEXUS, 10, 32)
  P.btn(t, "Open the official Nexus page", 10, 54, 230, function() shellExecute(P.NEXUS) end)
  P.lbl(t, "Got this table from anywhere else? Compare its SHA-256 with the one published on the Nexus page.", 248, 58)
  P.lbl(t, "1. Standalone: ddbridge.lua (v1.89.3) is bundled in this table; REFramework is downloaded once (about 13 MB) from praydog's official nightly and installed automatically.", 10, 92)
  P.lbl(t, "2. Just tick the panel entry: it starts DD2 via Steam if needed (restarting it when a new bridge was installed), attaches, connects, loads enums.", 10, 114)
  P.lbl(t, "Target and Vocation (top bar) apply to the Pawn / Player / Skills / Core tabs. Enums give real skill names - load them once per session.", 10, 136)
  local log = P.memo(t, 10, 166, 840, 480)
  P.logMemo = log
  P.logText = ""
  function P.log(s)
    P.logText = P.logText .. os.date("%H:%M:%S ") .. tostring(s) .. "\r\n"
    if #P.logText > 24000 then P.logText = P.logText:sub(-16000) end
    log.Lines.Text = P.logText
    P.status(tostring(s))
  end
  local oldStatus = P.status
  P.status = function(s)
    oldStatus(s)
    if P.verLbl and P.bridgeVersion then
      P.verLbl.Caption = "ddbridge " .. P.bridgeVersion
    end
  end
  P.btn(t, "Connect + load enums", 10, 656, 190, function()
    P.connect(function(ok)
      if ok then P.loadEnums(function() P.log("Ready.") end) end
    end)
  end)
  P.btn(t, "Install / update bridge + REFramework", 210, 656, 300, function()
    local gd = P.gameDir() or P.findGameDir()
    if gd then P.ensureInstalls(gd, true)
    else P.log("Game folder not found - start the game once, or attach to DD2.exe.") end
  end)
  P.lbl(t, "Ticking the panel entry does all of this automatically.", 520, 660)
end

---------------------------------------------------------------- Pawn tab
do
  local t = P.tab("Pawn")
  P.lbl(t, "Pawn rating (hearts / likes):", 10, 12)
  local goodE = P.edit(t, "", 10, 36, 70)
  local likeE = P.edit(t, "", 88, 36, 70)
  P.btn(t, "Read rating", 170, 34, 110, function()
    P.send("get_rating", {}, function(ok, p)
      if ok then
        local g, l = p:match("^(%-?%d+),(%-?%d+)")
        if g then goodE.Text = g likeE.Text = l end
        P.log("Rating: " .. p)
      else P.log("get_rating failed: " .. tostring(p)) end
    end)
  end)
  P.btn(t, "Set rating", 288, 34, 110, function()
    P.send("set_rating", { goodE.Text, likeE.Text }, function(ok, p)
      P.log(ok and "Rating set." or ("set_rating failed: " .. tostring(p)))
    end)
  end)
  P.lbl(t, "Favorability (0-1000):", 430, 12)
  local favE = P.edit(t, "", 430, 36, 70)
  P.btn(t, "Read", 508, 34, 70, function()
    P.send("get_fav", {}, function(ok, p)
      if ok then favE.Text = P.trim(p) end
      P.log(ok and ("Favorability: " .. p) or ("get_fav failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Set", 586, 34, 70, function()
    P.send("set_fav", { favE.Text }, function(ok, p)
      P.log(ok and "Favorability set." or ("set_fav failed: " .. tostring(p)))
    end)
  end)

  P.lbl(t, "Badges (Read loads all 50; names proven in-game, the rest described by quota - never guessed):", 10, 78)
  local badgeList = P.list(t, 10, 102, 560, 470)
  local badgeRows = {}
  local function badgeKind(q)
    q = P.trim(q or "")
    if q == "50" then return "Camp badge (camp 50x)" end
    if q == "30" or q == "20" or q == "10" or q == "5" then return "Slayer badge (" .. q .. " kills)" end
    if q == "1" then return "Badge (count 1)" end
    return "Badge"
  end
  P.btn(t, "Read badges", 10, 580, 120, function()
    P.send("get_badges", {}, function(ok, p)
      if not ok then P.log("get_badges failed: " .. tostring(p)) return end
      badgeRows = {}
      local lines = {}
      for _, row in ipairs(P.split(p, ";")) do
        local n, cur, quota, name = row:match("^%s*(%d+),(%-?%d+),(%-?%d+),(.*)$")
        if n then
          n = tonumber(n)
          badgeRows[#badgeRows + 1] = { n = n, cur = tonumber(cur), quota = tonumber(quota) }
          local shown = P.BADGE_NAMES[n] or badgeKind(quota)
          lines[#lines + 1] = string.format("PB%03d  %s   %s / %s", n, shown, cur, quota)
        end
      end
      P.setList(badgeList, lines)
      P.log("Read " .. #badgeRows .. " badges.")
    end)
  end)
  P.lbl(t, "Count:", 590, 102)
  local badgeValE = P.edit(t, "", 590, 126, 70)
  P.btn(t, "Set selected badge", 590, 158, 170, function()
    local i = P.sel(badgeList)
    if not i or not badgeRows[i] then P.log("Select a badge first.") return end
    local v = tonumber(badgeValE.Text)
    if not v then P.log("Enter a count.") return end
    P.send("set_badge", { badgeRows[i].n, v }, function(ok, p)
      P.log(ok and "Badge set." or ("set_badge failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Grant selected (fill to quota)", 590, 190, 170, function()
    local i = P.sel(badgeList)
    if not i or not badgeRows[i] then P.log("Select a badge first.") return end
    P.send("grant_badge", { badgeRows[i].n }, function(ok, p)
      P.log(ok and "Badge granted." or ("grant_badge failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Equip selected badge", 590, 222, 170, function()
    local i = P.sel(badgeList)
    if not i or not badgeRows[i] then P.log("Select a badge first.") return end
    P.send("badge_equip", { badgeRows[i].n }, function(ok, p)
      P.log(ok and "Badge equipped." or ("badge_equip failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Fill ALL badges", 590, 262, 170, function()
    P.send("fill_badges", {}, function(ok, p)
      P.log(ok and ("Fill badges: " .. tostring(p)) or ("fill_badges failed: " .. tostring(p)))
    end)
  end)

  P.lbl(t, "Party pawns (select one, then 'Select pawn' makes Pawn-tab commands target it where the bridge supports it):", 10, 616)
  local pawnList = P.list(t, 10, 640, 400, 62)
  local pawnIdx = {}
  P.btn(t, "List pawns", 420, 640, 110, function()
    P.send("list_pawns", {}, function(ok, p)
      if not ok then P.log("list_pawns failed: " .. tostring(p)) return end
      pawnIdx = {}
      local lines = {}
      for _, row in ipairs(P.split(p, ";")) do
        local i, name = row:match("^%s*(%d+),(.*)$")
        if i then
          pawnIdx[#pawnIdx + 1] = tonumber(i)
          lines[#lines + 1] = i .. ": " .. name
        end
      end
      P.setList(pawnList, lines)
      P.log("Listed " .. #pawnIdx .. " pawns.")
    end)
  end)
  P.btn(t, "Select pawn", 538, 640, 110, function()
    local i = P.sel(pawnList)
    if not i or not pawnIdx[i] then P.log("Select a pawn first.") return end
    P.send("select_pawn", { pawnIdx[i] }, function(ok, p)
      P.log(ok and "Pawn selected." or ("select_pawn failed: " .. tostring(p)))
    end)
  end)
end

---------------------------------------------------------------- Player tab
do
  local t = P.tab("Player")
  local infoLbl = P.lbl(t, "Info: (not read yet)", 10, 12)
  P.btn(t, "Read info", 10, 36, 110, function()
    P.send("get_info", { P.target() }, function(ok, p)
      if ok then
        local job, lvl = p:match("^(.*),(.*)$")
        local jn = P.JOBS[tonumber(job) or 0] or tostring(job)
        infoLbl.Caption = "Info: vocation " .. jn .. " (id " .. tostring(job) .. "), level " .. tostring(lvl)
      else P.log("get_info failed: " .. tostring(p)) end
    end)
  end)
  P.lbl(t, "Level (1-200):", 150, 12)
  local lvlE = P.edit(t, "", 150, 36, 70)
  P.btn(t, "Set level", 228, 34, 100, function()
    P.send("set_level", { P.target(), lvlE.Text }, function(ok, p)
      P.log(ok and "Level set." or ("set_level failed: " .. tostring(p)))
    end)
  end)
  P.lbl(t, "Add vocation EXP:", 360, 12)
  local expE = P.edit(t, "10000", 360, 36, 90)
  P.btn(t, "Add EXP", 458, 34, 100, function()
    P.send("add_job_exp", { P.target(), expE.Text }, function(ok, p)
      P.log(ok and "EXP added." or ("add_job_exp failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Set vocation (top-bar vocation)", 10, 74, 230, function()
    P.send("set_vocation", { P.target(), P.job() }, function(ok, p)
      P.log(ok and "Vocation set." or ("set_vocation failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Unlock ALL vocations", 248, 74, 190, function()
    P.send("unlock_all_vocations", { P.target() }, function(ok, p)
      P.log(ok and "All vocations unlocked." or ("unlock failed: " .. tostring(p)))
    end)
  end)

  P.lbl(t, "Base stats (get_core groups) - Read, pick a row, set its value. Lock keeps the value pinned in-game.", 10, 116)
  local coreList = P.list(t, 10, 140, 640, 300)
  local coreRows = {}
  P.btn(t, "Read stats", 10, 448, 110, function()
    P.send("get_core", { P.target() }, function(ok, p)
      if not ok then P.log("get_core failed: " .. tostring(p)) return end
      local text = P.readfile(P.dataDir .. "core.txt") or ""
      coreRows = {}
      local lines = {}
      for line in text:gmatch("[^\r\n]+") do
        local gi, title, field, label, value = line:match("^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t(.*)$")
        if gi and tonumber(gi) then
          coreRows[#coreRows + 1] = { gi = tonumber(gi), field = field }
          lines[#lines + 1] = "[" .. title .. "] " .. label .. " = " .. value
        end
      end
      P.setList(coreList, lines)
      P.log("Read " .. #coreRows .. " stat rows.")
    end)
  end)
  P.lbl(t, "Value:", 660, 140)
  local coreValE = P.edit(t, "", 660, 164, 90)
  local coreLock = P.check(t, "Lock", 660, 192, false)
  P.btn(t, "Set stat", 660, 220, 110, function()
    local i = P.sel(coreList)
    if not i or not coreRows[i] then P.log("Select a stat row first.") return end
    P.send("set_core", { P.target(), coreRows[i].gi, coreRows[i].field,
      coreValE.Text, coreLock.Checked and 1 or 0 }, function(ok, p)
      P.log(ok and "Stat set." or ("set_core failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Clear all locks", 660, 254, 110, function()
    P.send("clear_locks", {}, function(ok, p)
      P.log(ok and "Locks cleared." or ("clear_locks failed: " .. tostring(p)))
    end)
  end)

  P.lbl(t, "Stat search (filter required, e.g. 'attack'):", 10, 486)
  local filtE = P.edit(t, "", 10, 510, 150)
  local statList = P.list(t, 170, 486, 480, 190)
  local statRows = {}
  P.btn(t, "Search", 10, 544, 110, function()
    if P.trim(filtE.Text) == "" then P.log("Enter a filter first.") return end
    P.send("stat_search", { P.target(), filtE.Text, 400 }, function(ok, p)
      if not ok then P.log("stat_search failed: " .. tostring(p)) return end
      local text = P.readfile(P.dataDir .. "stats.txt") or ""
      statRows = {}
      local lines = {}
      for line in text:gmatch("[^\r\n]+") do
        local si, label, kind, name, value = line:match("^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t(.*)$")
        if si and tonumber(si) then
          statRows[#statRows + 1] = { si = tonumber(si), kind = kind, name = name }
          lines[#lines + 1] = label .. " / " .. name .. " = " .. value
        end
      end
      P.setList(statList, lines)
      P.log("Search found " .. #statRows .. " stats.")
    end)
  end)
  P.lbl(t, "Value:", 660, 486)
  local statValE = P.edit(t, "", 660, 510, 90)
  local statLock = P.check(t, "Lock", 660, 538, false)
  P.btn(t, "Set searched stat", 660, 566, 130, function()
    local i = P.sel(statList)
    if not i or not statRows[i] then P.log("Select a search row first.") return end
    local r = statRows[i]
    P.send("stat_set", { P.target(), r.si, r.kind, r.name, statValE.Text,
      statLock.Checked and 1 or 0 }, function(ok, p)
      P.log(ok and "Stat set." or ("stat_set failed: " .. tostring(p)))
    end)
  end)
end

---------------------------------------------------------------- Weapon Skills tab
do
  local t = P.tab("Weapon Skills")
  P.lbl(t, "Uses the top-bar Target + Vocation. Read state first; names come from Load enums.", 10, 12)
  local wList = P.list(t, 10, 40, 620, 420)
  local wRows = {}
  local function readW()
    P.send("get_wstate", { P.target(), P.job() }, function(ok, p)
      if not ok then P.log("get_wstate failed: " .. tostring(p)) return end
      wRows = {}
      local lines = {}
      for _, row in ipairs(P.split(p, ";")) do
        local sid, en, rest = row:match("^%s*(%-?%d+),([^,]*),(.*)$")
        if sid then
          sid = tonumber(sid)
          wRows[#wRows + 1] = sid
          local name = P.enumName("custom", sid) or ("Skill " .. sid)
          lines[#lines + 1] = string.format("%d  %s   enabled=%s  %s", sid, name, en, rest)
        end
      end
      P.setList(wList, lines)
      P.log("Read " .. #wRows .. " weapon skills for " .. P.JOBS[P.job()] .. ".")
    end)
  end
  P.btn(t, "Read state", 10, 468, 120, readW)
  P.lbl(t, "Level:", 650, 40)
  local wLvlE = P.edit(t, "5", 650, 64, 60)
  P.btn(t, "Set level (selected)", 650, 96, 170, function()
    local i = P.sel(wList)
    if not i or not wRows[i] then P.log("Select a skill first.") return end
    P.send("set_wlevel", { P.target(), wRows[i], wLvlE.Text }, function(ok, p)
      P.log(ok and "Level set." or ("set_wlevel failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Unlock selected", 650, 130, 170, function()
    local i = P.sel(wList)
    if not i or not wRows[i] then P.log("Select a skill first.") return end
    P.send("unlock_wskill", { P.target(), wRows[i], wLvlE.Text }, function(ok, p)
      P.log(ok and "Skill unlocked." or ("unlock_wskill failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Unlock ALL (vocation, at level)", 650, 164, 170, function()
    P.send("unlock_wskills", { P.target(), P.job(), wLvlE.Text }, function(ok, p)
      P.log(ok and ("Unlock all: " .. tostring(p)) or ("unlock_wskills failed: " .. tostring(p)))
    end)
  end)
  P.lbl(t, "Equip into slot (1-4):", 650, 206)
  local wSlotE = P.edit(t, "1", 650, 230, 60)
  P.btn(t, "Equip selected", 650, 262, 170, function()
    local i = P.sel(wList)
    if not i or not wRows[i] then P.log("Select a skill first.") return end
    local slot = (tonumber(wSlotE.Text) or 1) - 1  -- bridge slots are 0-based
    if slot < 0 or slot > 3 then P.log("Slot must be 1-4.") return end
    P.send("set_wskill", { P.target(), P.job(), slot, wRows[i], wLvlE.Text }, function(ok, p)
      P.log(ok and "Skill equipped." or ("set_wskill failed: " .. tostring(p)))
    end)
  end)
  P.lbl(t, "Add missing entry (SmokeGiants fix):", 650, 306)
  P.lbl(t, "Skill ID:", 650, 330)
  local addIdE = P.edit(t, "120", 650, 354, 60)
  P.btn(t, "Add entry at level", 650, 386, 170, function()
    P.send("wskill_add_entry", { P.target(), addIdE.Text, wLvlE.Text }, function(ok, p)
      P.log(ok and ("Entry added: " .. tostring(p)) or ("wskill_add_entry failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Clear equipped (vocation)", 650, 430, 170, function()
    P.send("clear_wskills", { P.target(), P.job() }, function(ok, p)
      P.log(ok and "Equipped weapon skills cleared." or ("clear_wskills failed: " .. tostring(p)))
    end)
  end)

  P.lbl(t, "Upgraded weapon skills (ExSkills): type the 5 skill IDs for the equipped weapon's slots, then Equip. Undo restores the previous picks.", 10, 512)
  local exE = {}
  for i = 1, 5 do exE[i] = P.edit(t, "", 10 + (i - 1) * 76, 540, 68) end
  P.btn(t, "Equip upgraded picks", 400, 538, 170, function()
    local picks = {}
    for i = 1, 5 do picks[#picks + 1] = P.trim(exE[i].Text) == "" and "0" or P.trim(exE[i].Text) end
    P.send("exskill_equip", { P.target(), P.job(), table.concat(picks, ",") }, function(ok, p)
      P.log(ok and ("ExSkills equipped: " .. tostring(p)) or ("exskill_equip failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Undo ExSkill equip", 578, 538, 150, function()
    P.send("exskill_undo", { P.target() }, function(ok, p)
      P.log(ok and "ExSkill equip undone." or ("exskill_undo failed: " .. tostring(p)))
    end)
  end)
end

---------------------------------------------------------------- Core & Augments tab
do
  local t = P.tab("Core & Augments")
  P.lbl(t, "Core skills for the top-bar Target + Vocation:", 10, 12)
  local nList = P.list(t, 10, 40, 620, 300)
  local nRows = {}
  P.btn(t, "Read core skills", 10, 348, 140, function()
    P.send("get_nstate", { P.target(), P.job() }, function(ok, p)
      if not ok then P.log("get_nstate failed: " .. tostring(p)) return end
      nRows = {}
      local lines = {}
      for _, row in ipairs(P.split(p, ";")) do
        local sid, en, tag = row:match("^%s*(%-?%d+),([^,]*),?(.*)$")
        if sid then
          sid = tonumber(sid)
          nRows[#nRows + 1] = sid
          local name = P.enumName("normal", sid) or ("Skill " .. sid)
          lines[#lines + 1] = string.format("%d  %s   enabled=%s%s", sid, name, en,
            tag == "other" and "   [no vocation prefix]" or "")
        end
      end
      P.setList(nList, lines)
      P.log("Read " .. #nRows .. " core skills.")
    end)
  end)
  P.btn(t, "Enable selected", 650, 40, 160, function()
    local i = P.sel(nList)
    if not i or not nRows[i] then P.log("Select a core skill first.") return end
    P.send("enable_nskill", { P.target(), nRows[i] }, function(ok, p)
      P.log(ok and "Core skill enabled." or ("enable_nskill failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Enable ALL core skills", 650, 74, 160, function()
    P.send("enable_nskills", { P.target(), P.job(), "all" }, function(ok, p)
      P.log(ok and ("Enable all core: " .. tostring(p)) or ("enable_nskills failed: " .. tostring(p)))
    end)
  end)

  P.lbl(t, "Augment slots (Read shows the 6 equipped augments; pick one from the full list, then Set slot):", 10, 392)
  local aList = P.list(t, 10, 420, 400, 150)
  local aCombo = P.combo(t, 420, 420, 300)
  local aIds = {}
  local function fillAugments()
    aIds = {}
    aCombo.Items.clear()
    if P.enums and P.enums.ability then
      local ids = {}
      for id in pairs(P.enums.ability) do ids[#ids + 1] = id end
      table.sort(ids)
      for _, id in ipairs(ids) do
        aIds[#aIds + 1] = id
        aCombo.Items.add(id .. "  " .. P.enums.ability[id])
      end
      if #aIds > 0 then aCombo.ItemIndex = 0 end
    end
  end
  P.btn(t, "Read augment slots", 10, 578, 150, function()
    fillAugments()
    P.send("get_augments", { P.target(), P.job() }, function(ok, p)
      if not ok then P.log("get_augments failed: " .. tostring(p)) return end
      local lines = {}
      local slot = 0
      for id in (p .. ","):gmatch("(.-),") do
        slot = slot + 1
        local n = tonumber(id) or 0
        lines[#lines + 1] = "Slot " .. slot .. ": " .. (n == 0 and "(empty)" or
          (n .. "  " .. (P.enumName("ability", n) or "")))
      end
      P.setList(aList, lines)
      P.log("Augment slots read.")
    end)
  end)
  P.btn(t, "Set selected slot", 420, 452, 150, function()
    local i = P.sel(aList)
    if not i then P.log("Select a slot first (Read augment slots).") return end
    local ci = aCombo.ItemIndex
    if ci == nil or ci < 0 or not aIds[ci + 1] then P.log("Pick an augment first (needs Load enums).") return end
    P.send("set_augment", { P.target(), P.job(), i - 1, aIds[ci + 1] }, function(ok, p)
      P.log(ok and "Augment set." or ("set_augment failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Clear selected slot", 420, 486, 150, function()
    local i = P.sel(aList)
    if not i then P.log("Select a slot first.") return end
    P.send("set_augment", { P.target(), P.job(), i - 1, 0 }, function(ok, p)
      P.log(ok and "Augment slot cleared." or ("set_augment failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Unlock ALL augments", 420, 520, 170, function()
    P.send("unlock_augments", { P.target(), P.job(), "all" }, function(ok, p)
      P.log(ok and ("Unlock augments: " .. tostring(p)) or ("unlock_augments failed: " .. tostring(p)))
    end)
  end)
end

---------------------------------------------------------------- Item Giver tab
do
  local t = P.tab("Item Giver")
  P.lbl(t, "Load the item list, click an item, set quantity, Give. IDs are validated by the bridge list itself.", 10, 12)
  local searchE = P.edit(t, "", 10, 40, 260)
  P.lbl(t, "search (filters as you type is not live - press Filter)", 278, 42)
  local itemList = P.list(t, 10, 72, 560, 560)
  local allItems, shownItems = {}, {}
  local function showItems()
    shownItems = {}
    local lines = {}
    local q = P.trim(searchE.Text):lower()
    for _, it in ipairs(allItems) do
      if q == "" or it.name:lower():find(q, 1, true) or tostring(it.id) == q then
        shownItems[#shownItems + 1] = it
        lines[#lines + 1] = it.id .. "   " .. it.name
      end
    end
    P.setListBulk(itemList, lines)
    return #lines
  end
  P.btn(t, "Load items", 10, 640, 120, function()
    P.send("list_items", {}, function(ok, p)
      if not ok then P.log("list_items failed: " .. tostring(p)) return end
      local text = P.readfile(P.dataDir .. "items.txt") or ""
      allItems = {}
      local total = 0
      for line in text:gmatch("[^\r\n]+") do
        total = total + 1
        local id, name = line:match("^(%d+)\t(.*)$")
        if id then allItems[#allItems + 1] = { id = tonumber(id), name = name } end
      end
      local shown = showItems()
      P.log("Items: bridge reported " .. tostring(p) .. ", items.txt has " .. total ..
        " lines, parsed " .. #allItems .. ", showing " .. shown .. ".")
    end)
  end)
  P.btn(t, "Filter", 138, 640, 90, showItems)
  P.lbl(t, "Quantity (1-999):", 590, 72)
  local qtyE = P.edit(t, "1", 590, 96, 70)
  local storC = P.check(t, "Send to storage", 590, 126, false)
  P.btn(t, "Give item", 590, 156, 140, function()
    local i = P.sel(itemList)
    if not i or not shownItems[i] then P.log("Select an item first.") return end
    local q = tonumber(qtyE.Text)
    if not q or q < 1 or q > 999 then P.log("Quantity must be 1-999.") return end
    local it = shownItems[i]
    P.send("give_item", { it.id, q, storC.Checked and 1 or 0 }, function(ok, p)
      P.log(ok and (p .. ": " .. q .. " x " .. it.name) or ("give_item failed: " .. tostring(p)))
    end)
  end)
  P.lbl(t, "Or type an ID directly:", 590, 206)
  local idE = P.edit(t, "", 590, 230, 90)
  P.btn(t, "Give by ID", 590, 262, 140, function()
    local id = tonumber(idE.Text)
    local q = tonumber(qtyE.Text)
    if not id or id < 1 then P.log("Enter a valid item ID.") return end
    if not q or q < 1 or q > 999 then P.log("Quantity must be 1-999.") return end
    local known = false
    for _, it in ipairs(allItems) do if it.id == id then known = true break end end
    if #allItems > 0 and not known then P.log("ID " .. id .. " is not in the loaded item list - not giving.") return end
    P.send("give_item", { id, q, storC.Checked and 1 or 0 }, function(ok, p)
      P.log(ok and (p .. ": " .. q .. " x item " .. id) or ("give_item failed: " .. tostring(p)))
    end)
  end)
end

---------------------------------------------------------------- Item Editor tab
do
  local t = P.tab("Item Editor")
  local ownerCombo = P.combo(t, 10, 12, 300)
  local ownerIdx = {}
  P.btn(t, "Load owners", 318, 10, 110, function()
    P.send("item_owners", {}, function(ok, p)
      if not ok then P.log("item_owners failed: " .. tostring(p)) return end
      ownerIdx = {}
      local labels = {}
      for _, row in ipairs(P.split(p, ";")) do
        local i, key, count, isp = row:match("^%s*(%d+),([^,]*),(%d+),(%d+)$")
        if i then
          ownerIdx[#ownerIdx + 1] = tonumber(i)
          labels[#labels + 1] = "owner " .. key .. " (" .. count .. " items)" .. (isp == "1" and "  <- YOU" or "")
        end
      end
      ownerCombo.Items.clear()
      for _, l in ipairs(labels) do ownerCombo.Items.add(l) end
      if #labels > 0 then ownerCombo.ItemIndex = 0 end
      P.log("Owners loaded: " .. #labels)
    end)
  end)
  local equipC = P.check(t, "Equipment only", 440, 12, false)
  local rowList = P.list(t, 10, 46, 430, 480)
  local rows = {}
  local function loadRows()
    local ci = ownerCombo.ItemIndex
    if ci == nil or ci < 0 or not ownerIdx[ci + 1] then P.log("Load owners first.") return end
    P.send("item_rows", { ownerIdx[ci + 1], equipC.Checked and 1 or 0, 0 }, function(ok, p)
      if not ok then P.log("item_rows failed: " .. tostring(p)) return end
      local text = P.readfile(P.dataDir .. "itemrows.txt") or ""
      rows = {}
      local lines = {}
      for line in text:gmatch("[^\r\n]+") do
        local i, name, eq, slots = line:match("^(%d+)\t([^\t]*)\t(%d)\t(.*)$")
        if i then
          local sl = {}
          for v in (slots .. ","):gmatch("(.-),") do sl[#sl + 1] = tonumber(v) or 0 end
          rows[#rows + 1] = { i = tonumber(i), name = name, slots = sl }
          lines[#lines + 1] = name .. (eq == "1" and "  [equipped]" or "")
        end
      end
      P.setList(rowList, lines)
      P.log("Loaded " .. #rows .. " item rows.")
    end)
  end
  P.btn(t, "Load items", 540, 10, 110, loadRows)
  local function selRow()
    local i = P.sel(rowList)
    if not i or not rows[i] then P.log("Select an item row first.") return nil end
    return rows[i]
  end
  local detMemo = P.memo(t, 452, 46, 400, 150)
  P.btn(t, "Read details", 452, 204, 120, function()
    local r = selRow() if not r then return end
    P.send("item_get", { r.i }, function(ok, p)
      if ok then detMemo.Lines.Text = "ability slots/appr/params: " .. p end
      P.send("item_get_element", { r.i }, function(ok2, p2)
        if ok2 then detMemo.Lines.Text = detMemo.Lines.Text .. "\r\nelement: " .. p2 end
        P.send("item_get_enh", { r.i }, function(ok3, p3)
          if ok3 then detMemo.Lines.Text = detMemo.Lines.Text .. "\r\nenhance (num,cap,types...): " .. p3 end
          P.send("item_get_special", { r.i }, function(ok4, p4)
            if ok4 then detMemo.Lines.Text = detMemo.Lines.Text .. "\r\nspecial (id,v1,v2,v3): " .. p4 end
            P.send("item_get_name", { r.i }, function(ok5, p5)
              if ok5 then detMemo.Lines.Text = detMemo.Lines.Text .. "\r\nname: " .. p5 end
            end)
          end)
        end)
      end)
    end)
  end)
  -- element
  P.lbl(t, "Element (name, e.g. Fire / Ice / Lightning / Holy / Dark / None):", 452, 240)
  local elemE = P.edit(t, "", 452, 264, 130)
  P.btn(t, "Set element", 590, 262, 110, function()
    local r = selRow() if not r then return end
    P.send("item_set_element", { r.i, elemE.Text }, function(ok, p)
      P.log(ok and "Element set (press Apply changes)." or ("item_set_element failed: " .. tostring(p)))
    end)
  end)
  -- enhance
  P.lbl(t, "Enhance level (types are kept from the item):", 452, 300)
  local enhE = P.edit(t, "", 452, 324, 60)
  P.btn(t, "Set enhance level", 520, 322, 140, function()
    local r = selRow() if not r then return end
    P.send("item_get_enh", { r.i }, function(ok, p)
      if not ok then P.log("item_get_enh failed: " .. tostring(p)) return end
      local parts = P.split(p, ",")
      local types = { parts[3] or 0, parts[4] or 0, parts[5] or 0, parts[6] or 0 }
      P.send("item_set_enh", { r.i, enhE.Text, types[1], types[2], types[3], types[4] }, function(ok2, p2)
        P.log(ok2 and "Enhance set (press Apply changes)." or ("item_set_enh failed: " .. tostring(p2)))
      end)
    end)
  end)
  -- special effect
  P.lbl(t, "Special effect (id, v1, v2, v3):", 452, 362)
  local spE = {}
  for i = 1, 4 do spE[i] = P.edit(t, "", 452 + (i - 1) * 62, 386, 56) end
  P.btn(t, "Set special", 452, 418, 110, function()
    local r = selRow() if not r then return end
    P.send("item_set_special", { r.i, spE[1].Text, spE[2].Text, spE[3].Text, spE[4].Text }, function(ok, p)
      P.log(ok and "Special set (press Apply changes)." or ("item_set_special failed: " .. tostring(p)))
    end)
  end)
  P.btn(t, "Read special", 570, 418, 110, function()
    local r = selRow() if not r then return end
    P.send("item_get_special", { r.i }, function(ok, p)
      if ok then
        local v = P.split(p, ",")
        for i = 1, 4 do spE[i].Text = v[i] or "" end
      end
      P.log(ok and ("Special: " .. p) or ("item_get_special failed: " .. tostring(p)))
    end)
  end)
  -- custom name
  P.lbl(t, "Custom name:", 452, 456)
  local nameE = P.edit(t, "", 452, 480, 200)
  P.btn(t, "Set name", 660, 478, 100, function()
    local r = selRow() if not r then return end
    P.send("item_set_name", { r.i, nameE.Text }, function(ok, p)
      P.log(ok and tostring(p) or ("item_set_name failed: " .. tostring(p)))
    end)
  end)
  -- misc row actions
  P.btn(t, "Item totals", 452, 518, 110, function()
    local r = selRow() if not r then return end
    P.send("item_totals", { r.i }, function(ok, p)
