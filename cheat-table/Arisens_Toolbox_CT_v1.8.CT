---------------------------------------------------------------- Duplicate tab
do
  local t = P.tab("Duplicate")
  local ownerCombo = P.combo(t, 10, 12, 300)
  local ownerIdx = {}
  P.btn(t, "Load owners", 318, 10, 110, function()
    P.send("dup_owners", {}, function(ok, p)
      if not ok then P.log("dup_owners failed: " .. tostring(p)) return end
      ownerIdx = {}
      local labels = {}
      for _, row in ipairs(P.split(p, ";")) do
        local i, key, count, isp = row:match("^%s*(%d+),([^,]*),(%d+),(%d+)$")
        if i then
          ownerIdx[#ownerIdx + 1] = tonumber(i)
          labels[#labels + 1] = "owner " .. key .. " (" .. count .. " items)" .. (isp == "1" and "  <- YOU" or "")
        end
      end
      ownerCombo.Items.clear()
      for _, l in ipairs(labels) do ownerCombo.Items.add(l) end
      if #labels > 0 then ownerCombo.ItemIndex = 0 end
      P.log("Owners loaded: " .. #labels)
    end)
  end)
  local equipC = P.check(t, "Equipment only", 440, 12, false)
  local dupList = P.list(t, 10, 46, 560, 480)
  local dupRows = {}
  P.btn(t, "Load items", 540, 10, 110, function()
    local ci = ownerCombo.ItemIndex
    if ci == nil or ci < 0 or not ownerIdx[ci + 1] then P.log("Load owners first.") return end
    P.send("dup_rows", { ownerIdx[ci + 1], equipC.Checked and 1 or 0 }, function(ok, p)
      if not ok then P.log("dup_rows failed: " .. tostring(p)) return end
      local text = P.readfile(P.dataDir .. "duprows.txt") or ""
      dupRows = {}
      local lines = {}
      for line in text:gmatch("[^\r\n]+") do
        local row, name, id, count = line:match("^(%d+)\t([^\t]*)\t([^\t]*)\t([^\t]*)")
        if row then
          dupRows[#dupRows + 1] = tonumber(row)
          lines[#lines + 1] = name .. "  (id " .. id .. ", count " .. count .. ")"
        end
      end
      P.setList(dupList, lines)
      P.log("Loaded " .. #dupRows .. " rows.")
    end)
  end)
  P.lbl(t, "Copies (0 = same stack size):", 590, 46)
  local copE = P.edit(t, "1", 590, 70, 60)
  local storC = P.check(t, "To storage", 590, 100, false)
  local propC = P.check(t, "Keep properties", 590, 124, true)
  P.btn(t, "Duplicate selected", 590, 156, 150, function()
    local i = P.sel(dupList)
    if not i or not dupRows[i] then P.log("Select a row first.") return end
    P.send("dup_do", { dupRows[i], copE.Text, storC.Checked and 1 or 0,
      propC.Checked and 1 or 0 }, function(ok, p)
      P.log(ok and ("Duplicated: " .. tostring(p)) or ("dup_do failed: " .. tostring(p)))
    end)
  end)
end

